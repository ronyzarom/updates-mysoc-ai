# Cascade updater privilege boundary: the unprivileged updater may run
# exactly one root command, bare or with a single lifecycle phase argument
# (UPDATE-ENTRYPOINT-CONTRACT: updater >= 1.9.1 appends "apply" or
# "rollback"; the executor health gate passes "health"; the one-command
# fresh-host bring-up passes "first_install". Older updaters pass
# nothing. The wrapper resolves and
# validates everything else itself; no SETENV — it ignores caller env by
# design. Do not widen this to wildcards or paths under the updater-writable
# tree.
siemcore-cascade-updater ALL=(root) NOPASSWD: /usr/local/sbin/siemcore-apply-update "", /usr/local/sbin/siemcore-apply-update apply, /usr/local/sbin/siemcore-apply-update rollback, /usr/local/sbin/siemcore-apply-update health, /usr/local/sbin/siemcore-apply-update first_install
