#!/usr/bin/env bash
# Protocol 1 host boundary. The only caller-controlled input is the phase.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
[[ $(id -u) == 0 && $# == 1 ]] || exit 1
case "$1" in apply|rollback) ;; *) exit 1 ;; esac
exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LANG=C.UTF-8 /usr/bin/python3 /usr/local/lib/siemcore-recovery/1.0.0.4/recovery.py "$1"
