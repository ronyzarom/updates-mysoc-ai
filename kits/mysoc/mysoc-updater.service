[Unit]
Description=MySoc platform updater (cascade relay to updates.mysoc.ai)
After=network-online.target
Wants=network-online.target
# Survivability (1.18.0): if the updater restarts too fast too often — the
# signature of a self-update to a binary that cannot stay up — systemd stops
# flapping it and triggers the restore unit, which rolls the self-update layout
# back to .previous and starts a known-good binary.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=mysoc-updater-restore.service

[Service]
# Type=notify: the updater signals READY=1 only after it has settled any pending
# self-update, so a binary that never reaches readiness is a failed start (and
# OnFailure restores .previous). WatchdogSec restarts a process that stops
# pinging — a wedged process, or a relay whose child-facing listener is dead
# (the relay pings only while its listener self-probe passes). The in-process
# cycle/product/download deadlines bound progress; this is the last-resort
# backstop. WatchdogSec must exceed the watchdog ping interval, not the cycle
# length — the pinger is decoupled from cycle duration, so a long first_install
# never trips it.
Type=notify
NotifyAccess=main
WatchdogSec=180
User=mysoc-updater
Group=mysoc-updater
ExecStart=/usr/local/bin/mysoc-updater relay --config /etc/mysoc-updater/config.yaml
Restart=always
RestartSec=10
# The updater drains in-flight work for up to drain_timeout (2 m) on stop and
# signals STOPPING=1 when it begins, so systemd's default 90 s stop timeout
# would SIGKILL mid-drain. Give the drain headroom (2 m drain + margin).
TimeoutStopSec=150
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mysoc-updater
PrivateTmp=true

[Install]
WantedBy=multi-user.target
